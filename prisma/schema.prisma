// BiteTrack Prisma schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm, vector, citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VendorStatus {
  OFFLINE
  ONLINE
  ON_ROUTE
  AVAILABLE
  BUSY
}

enum ShiftStatus {
  ACTIVE
  ENDED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationType {
  VENDOR_NEARBY
  FAVORITE_VENDOR_NEARBY
  PROMOTION
  SHIFT_STARTED
  SHIFT_ENDED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  firstName       String?
  lastName        String?
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  vendorProfile VendorProfile?
  refreshTokens RefreshToken[]
  reviews       Review[]
  favorites     Favorite[]
  devices       Device[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Vendor domain
// ---------------------------------------------------------------------------

model Category {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  slug    String  @unique
  iconUrl String?

  vendors VendorProfile[]

  @@index([name])
  @@map("categories")
}

model VendorProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @db.Uuid
  categoryId         String?                  @db.Uuid
  businessName       String
  description        String?
  bannerUrl          String?
  verificationStatus VendorVerificationStatus @default(PENDING)
  status             VendorStatus             @default(OFFLINE)
  averageRating      Float                    @default(0)
  reviewCount        Int                      @default(0)
  // Last known location; the live position is cached in Redis for low latency.
  lastLocation       Unsupported("geography(Point, 4326)")?
  lastSeenAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products  Product[]
  reviews   Review[]
  favorites Favorite[]
  shifts    VendorShift[]

  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
  @@map("vendor_profiles")
}

model VendorShift {
  id        String      @id @default(uuid()) @db.Uuid
  vendorId  String      @db.Uuid
  status    ShiftStatus @default(ACTIVE)
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  vendor    VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  locations VendorLocationPing[]

  @@index([vendorId])
  @@index([status])
  @@map("vendor_shifts")
}

model VendorLocationPing {
  id         String                               @id @default(uuid()) @db.Uuid
  shiftId    String                               @db.Uuid
  location   Unsupported("geography(Point, 4326)")
  heading    Float?
  speed      Float?
  recordedAt DateTime                             @default(now())

  shift VendorShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([recordedAt])
  @@map("vendor_location_pings")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @db.Uuid
  name        String
  description String?
  priceCents  Int      @default(0)
  currency    String   @default("PHP")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  vendorId   String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photos   ReviewPhoto[]

  @@unique([vendorId, customerId])
  @@index([vendorId])
  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  vendorId   String   @db.Uuid
  createdAt  DateTime @default(now())

  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@index([vendorId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  fcmToken  String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}
