generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bitetrack_dev"]
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN

  @@schema("bitetrack_dev")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("bitetrack_dev")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM

  @@schema("bitetrack_dev")
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("bitetrack_dev")
}

enum VendorStatus {
  OFFLINE
  ONLINE
  ON_ROUTE
  AVAILABLE
  BUSY

  @@schema("bitetrack_dev")
}

enum ShiftStatus {
  ACTIVE
  ENDED

  @@schema("bitetrack_dev")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB

  @@schema("bitetrack_dev")
}

enum NotificationType {
  VENDOR_NEARBY
  FAVORITE_VENDOR_NEARBY
  PROMOTION
  SHIFT_STARTED
  SHIFT_ENDED
  SYSTEM

  @@schema("bitetrack_dev")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String?
  googleId        String?    @unique
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  firstName       String?
  lastName        String?
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  themePreference ThemePreference @default(SYSTEM)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  vendorProfile VendorProfile?
  refreshTokens RefreshToken[]
  reviews       Review[]
  favorites     Favorite[]
  devices       Device[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
  @@schema("bitetrack_dev")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("bitetrack_dev")
}

model Category {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  slug    String  @unique
  iconUrl String?

  vendors VendorProfile[]

  @@index([name])
  @@map("categories")
  @@schema("bitetrack_dev")
}

model VendorProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @db.Uuid
  categoryId         String?                  @db.Uuid
  businessName       String
  description        String?
  bannerUrl          String?
  verificationStatus VendorVerificationStatus @default(PENDING)
  status             VendorStatus             @default(OFFLINE)
  averageRating      Float                    @default(0)
  reviewCount        Int                      @default(0)
  lastLocation       Unsupported("geography(Point, 4326)")?
  lastSeenAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products  Product[]
  reviews   Review[]
  favorites Favorite[]
  shifts    VendorShift[]

  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
  @@map("vendor_profiles")
  @@schema("bitetrack_dev")
}

model VendorShift {
  id        String      @id @default(uuid()) @db.Uuid
  vendorId  String      @db.Uuid
  status    ShiftStatus @default(ACTIVE)
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  vendor    VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  locations VendorLocationPing[]

  @@index([vendorId])
  @@index([status])
  @@map("vendor_shifts")
  @@schema("bitetrack_dev")
}

model VendorLocationPing {
  id         String                               @id @default(uuid()) @db.Uuid
  shiftId    String                               @db.Uuid
  location   Unsupported("geography(Point, 4326)")
  heading    Float?
  speed      Float?
  recordedAt DateTime                             @default(now())

  shift VendorShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([recordedAt])
  @@map("vendor_location_pings")
  @@schema("bitetrack_dev")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @db.Uuid
  name        String
  description String?
  priceCents  Int      @default(0)
  currency    String   @default("PHP")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("products")
  @@schema("bitetrack_dev")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  vendorId   String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photos   ReviewPhoto[]

  @@unique([vendorId, customerId])
  @@index([vendorId])
  @@map("reviews")
  @@schema("bitetrack_dev")
}

model ReviewPhoto {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
  @@schema("bitetrack_dev")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  vendorId   String   @db.Uuid
  createdAt  DateTime @default(now())

  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@index([vendorId])
  @@map("favorites")
  @@schema("bitetrack_dev")
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  fcmToken  String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
  @@schema("bitetrack_dev")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
  @@schema("bitetrack_dev")
}
