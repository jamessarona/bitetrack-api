generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bitetrack_dev"]
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@schema("bitetrack_dev")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("bitetrack_dev")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM

  @@schema("bitetrack_dev")
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("VendorVerificationStatus")
  @@schema("bitetrack_dev")
}

enum BusinessStatus {
  OFFLINE
  ONLINE
  ON_ROUTE
  AVAILABLE
  BUSY

  @@map("VendorStatus")
  @@schema("bitetrack_dev")
}

enum ShiftStatus {
  ACTIVE
  ENDED

  @@schema("bitetrack_dev")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB

  @@schema("bitetrack_dev")
}

enum NotificationType {
  BUSINESS_NEARBY
  FAVORITE_BUSINESS_NEARBY
  PROMOTION
  SHIFT_STARTED
  SHIFT_ENDED
  SYSTEM

  @@schema("bitetrack_dev")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.Citext
  passwordHash    String?
  googleId        String?         @unique
  role            UserRole        @default(CUSTOMER)
  status          UserStatus      @default(ACTIVE)
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  themePreference ThemePreference @default(SYSTEM)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  businesses    Business[]
  refreshTokens RefreshToken[]
  reviews       Review[]
  favorites     Favorite[]
  devices       Device[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
  @@schema("bitetrack_dev")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("bitetrack_dev")
}

model Category {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  slug    String  @unique
  iconUrl String?

  businesses Business[]

  @@index([name])
  @@map("categories")
  @@schema("bitetrack_dev")
}

model Business {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @db.Uuid
  categoryId         String?                    @db.Uuid
  slug               String                     @unique
  businessName       String
  description        String?
  logoUrl            String?
  bannerUrl          String?
  verificationStatus BusinessVerificationStatus @default(PENDING)
  status             BusinessStatus             @default(OFFLINE)
  averageRating      Float                      @default(0)
  reviewCount        Int                        @default(0)
  lastLocation       Unsupported("geography(Point, 4326)")?
  lastSeenAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  owner     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products  Product[]
  reviews   Review[]
  favorites Favorite[]
  shifts    BusinessShift[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
  @@map("businesses")
  @@schema("bitetrack_dev")
}

model BusinessShift {
  id         String      @id @default(uuid()) @db.Uuid
  businessId String      @db.Uuid
  status     ShiftStatus @default(ACTIVE)
  startedAt  DateTime    @default(now())
  endedAt    DateTime?

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locations BusinessLocationPing[]

  @@index([businessId])
  @@index([status])
  @@map("business_shifts")
  @@schema("bitetrack_dev")
}

model BusinessLocationPing {
  id         String                               @id @default(uuid()) @db.Uuid
  shiftId    String                               @db.Uuid
  location   Unsupported("geography(Point, 4326)")
  heading    Float?
  speed      Float?
  recordedAt DateTime                             @default(now())

  shift BusinessShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([recordedAt])
  @@map("business_location_pings")
  @@schema("bitetrack_dev")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  description String?
  priceCents  Int      @default(0)
  currency    String   @default("PHP")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("products")
  @@schema("bitetrack_dev")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photos   ReviewPhoto[]

  @@unique([businessId, customerId])
  @@index([businessId])
  @@map("reviews")
  @@schema("bitetrack_dev")
}

model ReviewPhoto {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
  @@schema("bitetrack_dev")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  businessId String   @db.Uuid
  createdAt  DateTime @default(now())

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([customerId, businessId])
  @@index([businessId])
  @@map("favorites")
  @@schema("bitetrack_dev")
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  fcmToken  String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
  @@schema("bitetrack_dev")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
  @@schema("bitetrack_dev")
}
