# ============================================================================
# BiteTrack API - Environment Template
# ----------------------------------------------------------------------------
# Copy this file to the environment you want to run:
#   cp .env.sample .env                 # generic local override (git-ignored)
# The application loads `.env.<NODE_ENV>` first, then `.env` as an override.
#
# NEVER put real production secrets in committed files. In staging/production
# secrets are injected by the platform (Kubernetes Secrets / AWS Secrets
# Manager / GitHub Actions secrets). The values here are safe placeholders.
# ============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=bitetrack-api
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug                 # trace | debug | info | warn | error | fatal

# --- CORS ---
# Comma-separated list of allowed origins. Use * only for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- PostgreSQL (used by docker-compose to provision the DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bitetrack
POSTGRES_PASSWORD=change_me_in_secret_manager
POSTGRES_DB=bitetrack
# Prisma connection string. When the API runs INSIDE docker-compose use the
# service name `postgres` as the host instead of `localhost`.
DATABASE_URL=postgresql://bitetrack:change_me_in_secret_manager@localhost:5432/bitetrack?schema=public

# --- Redis (cache, sessions, rate-limit, pub/sub) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- JWT / Auth ---
# Generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_strong_random_secret_access
JWT_REFRESH_SECRET=replace_with_strong_random_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=bitetrack
JWT_AUDIENCE=bitetrack-clients

# --- Cookies ---
COOKIE_SECRET=replace_with_strong_random_secret_cookie

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Object storage (S3 compatible) [future / optional] ---
# S3_ENDPOINT=
# S3_REGION=ap-southeast-1
# S3_BUCKET=bitetrack-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Push notifications (Firebase Cloud Messaging) [future / optional] ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
