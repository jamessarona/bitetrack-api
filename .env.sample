NODE_ENV=development
APP_NAME=bitetrack-api
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=bitetrack
POSTGRES_PASSWORD=change_me_in_secret_manager
POSTGRES_DB=bitetrack_app
DATABASE_URL=postgresql://bitetrack:change_me_in_secret_manager@localhost:5433/bitetrack_app?schema=bitetrack_dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace_with_strong_random_secret_access
JWT_REFRESH_SECRET=replace_with_strong_random_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=bitetrack
JWT_AUDIENCE=bitetrack-clients

COOKIE_SECRET=replace_with_strong_random_secret_cookie

GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_client_secret

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Storage driver: s3 (default) or gcs
STORAGE_DRIVER=s3
STORAGE_UPLOAD_URL_TTL_MS=900000

# AWS S3 (required when STORAGE_DRIVER=s3)
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_ACCESS_KEY_ID=your_aws_access_key_id
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_REGION=us-west-1
AWS_S3_BASE_URL=https://your-bucket.s3.us-west-1.amazonaws.com

# GCS (optional — use when STORAGE_DRIVER=gcs)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=bitetrack-media-dev
GCS_KEY_FILE=./secrets/gcs-service-account.json
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com