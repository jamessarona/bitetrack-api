# ============================================================================
# BiteTrack API - DEVELOPMENT
# Safe local defaults that work with the bundled docker-compose stack.
# These are local-only credentials and are intentionally committed.
# ============================================================================

NODE_ENV=development
APP_NAME=bitetrack-api
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# PostgreSQL (matches docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bitetrack
POSTGRES_PASSWORD=bitetrack
POSTGRES_DB=bitetrack
DATABASE_URL=postgresql://bitetrack:bitetrack@localhost:5432/bitetrack?schema=public

# Redis (matches docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT (development-only secrets - DO NOT reuse anywhere else)
JWT_ACCESS_SECRET=dev_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=bitetrack
JWT_AUDIENCE=bitetrack-clients

COOKIE_SECRET=dev_cookie_secret_do_not_use_in_prod

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
