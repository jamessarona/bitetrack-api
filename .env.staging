# ============================================================================
# BiteTrack API - STAGING (placeholders only)
# ----------------------------------------------------------------------------
# Real secrets MUST be injected at deploy time by the platform
# (Kubernetes Secrets / AWS Secrets Manager / GitHub Actions secrets).
# Do NOT commit real credentials here.
# ============================================================================

NODE_ENV=staging
APP_NAME=bitetrack-api
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

CORS_ORIGINS=https://staging.bitetrack.app

# PostgreSQL - injected by the platform
POSTGRES_HOST=${POSTGRES_HOST}
POSTGRES_PORT=5432
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=bitetrack
DATABASE_URL=${DATABASE_URL}

# Redis - injected by the platform
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=${REDIS_URL}

# JWT - injected by the platform secret manager
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=bitetrack
JWT_AUDIENCE=bitetrack-clients

COOKIE_SECRET=${COOKIE_SECRET}

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
