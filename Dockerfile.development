# syntax=docker/dockerfile:1
# ============================================================================
# BiteTrack API - DEVELOPMENT image
# Optimized for fast feedback: full deps + hot reload (tsx watch).
# Source is bind-mounted by docker-compose, so code changes reload instantly.
# ============================================================================
FROM node:22-bookworm-slim AS development

ENV NODE_ENV=development
WORKDIR /app

# OpenSSL is required by the Prisma query engine.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Generate the Prisma client (schema copied before the rest of the source).
COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 4000
STOPSIGNAL SIGTERM

CMD ["npm", "run", "dev"]
